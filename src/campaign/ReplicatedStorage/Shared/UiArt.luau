-- Shared.UiArt: every authored menu image, key -> {Id, W, H, Slice} (CORE, 2 Nov 2026).
-- Each child ModuleScript is generated by `layerkit.py uiart <stem>` (one per screen and variant, e.g. Home_Wide)
-- or holds shared kit or render art; this module merges them. Never edit the children by hand.
-- Atlas (atlas.py, 4 Nov 2026) goes last: for each packed key it swaps Id to the shared sprite sheet and adds
-- Rect = {x, y, w, h} (pixels on the sheet), so appliers set ImageRectOffset/ImageRectSize. W and H stay the source size.

local merged = {}

local function add(m)
	local ok, t = pcall(require, m)
	if ok and type(t) == "table" then
		for k, v in t do
			merged[k] = v
		end
	else
		warn("[UiArt] could not load", m:GetFullName(), t)
	end
end

for _, c in script:GetChildren() do
	if c:IsA("ModuleScript") and c.Name ~= "Atlas" then
		add(c)
	end
end

local atlas = script:FindFirstChild("Atlas")
if atlas then
	local ok, t = pcall(require, atlas)
	if ok and type(t) == "table" then
		for k, v in t do
			local base = merged[k]
			if type(base) == "table" and not base.Slice then
				local e = table.clone(base)
				e.Id, e.Rect = v.Id, v.Rect
				merged[k] = e
			elseif base == nil then
				merged[k] = v
			end
		end
	else
		warn("[UiArt] could not load Atlas", t)
	end
end

return merged
